<Window
    x:Class="MicaPDF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MicaPDF"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarHost" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="TitleBarDragElement"
                    Grid.Column="1"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>
            <TextBlock x:Name="TitleBarFileName"
                       Grid.Column="1"
                       Text=""
                       FontSize="12"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Opacity="0.8"
                       IsHitTestVisible="False"/>
        </Grid>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        PaneDisplayMode="Left"
                        OpenPaneLength="280"
                        IsPaneToggleButtonVisible="True"
                        Header="">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="OpenFileItem" Icon="OpenFile" Content="Open" Tag="open"/>
                <NavigationViewItem x:Name="PrintItem" Icon="Print" Content="Print" Tag="print"/>
                <NavigationViewItem x:Name="SaveItem" Icon="Save" Content="Save annotated PDF" Tag="savewithannotations"/>

                <NavigationViewItemSeparator x:Name="Sep1"/>

                <NavigationViewItem x:Name="ZoomInItem" Icon="ZoomIn" Content="Zoom in" Tag="zoomin"/>
                <NavigationViewItem x:Name="ZoomOutItem" Icon="ZoomOut" Content="Zoom out" Tag="zoomout"/>
                <NavigationViewItem x:Name="ZoomResetItem" Tag="zoomreset">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71E;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Actual size"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ZoomFitItem" Tag="zoomfit">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9A6;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Fit page"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItemSeparator x:Name="Sep2"/>

                <NavigationViewItemHeader x:Name="PageHeaderTextBlock" Content="Page 1 / 1"/>
                <NavigationViewItem x:Name="OutlineItem" Tag="outline">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock x:Name="OutlineModeTextBlock" Text="Chapters"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem x:Name="GoToPageItem" Content="Go to page..." Tag="gotopage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8CB;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NextPageItem" Icon="Next" Content="Next page" Tag="nextpage"/>
                <NavigationViewItem x:Name="PrevPageItem" Icon="Previous" Content="Previous page" Tag="prevpage"/>
                <NavigationViewItem x:Name="DoublePageItem" Tag="doublepagemode">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE89A;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock x:Name="DoublePageModeTextBlock" Text="Double page"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CoverPageItem" Tag="coverpagemode" Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7ad;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock x:Name="CoverPageModeTextBlock" Text="Cover page"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ContinuousItem" Tag="continuousmode">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF571;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock x:Name="ContinuousModeTextBlock" Text="Continuous scroll"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>

                <NavigationViewItemSeparator x:Name="Sep3"/>

                <NavigationViewItem x:Name="EditItem" Tag="edit">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70F;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Edit"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ClearInkItem" Tag="clearink">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <TextBlock Text="Clear annotations"/>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid x:Name="NavContentRoot" FlowDirection="LeftToRight">
                <ContentDialog x:Name="GoToPageDialog"
                              Title="Go to page"
                              PrimaryButtonText="Go"
                              CloseButtonText="Cancel"
                              DefaultButton="Primary"
                              PrimaryButtonClick="GoToPageDialog_PrimaryButtonClick">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Enter the page number:" TextWrapping="Wrap"/>
                        <NumberBox x:Name="PageNumberBox"
                                  PlaceholderText="Page number"
                                  SpinButtonPlacementMode="Hidden"
                                  Minimum="1"
                                  Value="1"
                                  LargeChange="1"
                                  SmallChange="1"
                                  KeyDown="PageNumberBox_KeyDown"/>
                    </StackPanel>
                </ContentDialog>

                <Grid>
                        <Border x:Name="ViewerPanel"
                                FlowDirection="LeftToRight"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="8"
                                Margin="8"
                                AllowDrop="True"
                                DragOver="ViewerPanel_DragOver"
                                Drop="ViewerPanel_Drop">

                            <SplitView x:Name="OutlineSplitView"
                                       PanePlacement="Left"
                                       OpenPaneLength="280"
                                       CompactPaneLength="0"
                                       DisplayMode="Inline"
                                       IsPaneOpen="False">
                                <SplitView.Pane>
                                    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="OutlineHeaderText"
                                                   Grid.Row="0"
                                                   Margin="16,12,16,8"
                                                   FontWeight="SemiBold"
                                                   Text="Chapters"/>
                                        <Grid Grid.Row="1">
                                            <TreeView x:Name="OutlineTreeView"
                                                      SelectionMode="Single"
                                                      ItemInvoked="OutlineTreeView_ItemInvoked"/>
                                            <TextBlock x:Name="OutlineEmptyText"
                                                       Margin="16"
                                                       Opacity="0.7"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Top"
                                                       Visibility="Collapsed"/>
                                        </Grid>
                                    </Grid>
                                </SplitView.Pane>
                                <SplitView.Content>
                            <Grid>
                                <ScrollViewer x:Name="PdfScrollViewer"
                                            HorizontalScrollBarVisibility="Auto"
                                            VerticalScrollBarVisibility="Auto"
                                            ZoomMode="Enabled"
                                            MinZoomFactor="0.5"
                                            MaxZoomFactor="5.0"
                                            HorizontalScrollMode="Enabled"
                                            VerticalScrollMode="Enabled"
                                            IsHorizontalRailEnabled="True"
                                            IsVerticalRailEnabled="True"
                                            ManipulationMode="System"
                                            PointerWheelChanged="PdfScrollViewer_PointerWheelChanged"
                                            ViewChanged="PdfScrollViewer_ViewChanged">
                                    <Grid x:Name="PdfContainer"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Top"
                                          Padding="32">

                                        <Grid x:Name="SinglePageContainer" HorizontalAlignment="Center">
                                            <Image x:Name="PdfImage"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   SizeChanged="PageImage_SizeChanged"/>
                                            <local:AnnotationOverlay x:Name="PdfAnnotationOverlay"/>
                                        </Grid>

                                        <StackPanel x:Name="DoublePageContainer"
                                                    Orientation="Horizontal"
                                                    Spacing="16"
                                                    Visibility="Collapsed"
                                                    HorizontalAlignment="Center">
                                            <Grid>
                                                <Image x:Name="PdfImageLeft"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       SizeChanged="PageImage_SizeChanged"/>
                                                <local:AnnotationOverlay x:Name="PdfAnnotationOverlayLeft"/>
                                            </Grid>
                                            <Grid>
                                                <Image x:Name="PdfImageRight"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       SizeChanged="PageImage_SizeChanged"/>
                                                <local:AnnotationOverlay x:Name="PdfAnnotationOverlayRight"/>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel x:Name="ContinuousPageContainer"
                                                    Orientation="Vertical"
                                                    Spacing="16"
                                                    Visibility="Collapsed"
                                                    HorizontalAlignment="Center"/>
                                    </Grid>
                                </ScrollViewer>

                                <local:InkToolBar x:Name="AnnotationToolbar"
                                                  Visibility="Collapsed"/>

                                <Grid x:Name="WelcomePanel" Padding="48">
                                    <StackPanel HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Spacing="16"
                                               MaxWidth="420">
                                        <Viewbox Width="72" Height="72">
                                            <SymbolIcon Symbol="Document"/>
                                        </Viewbox>
                                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                                            <TextBlock x:Name="WelcomeTitleText"
                                                      FontSize="22"
                                                      FontWeight="SemiBold"
                                                      HorizontalAlignment="Center"
                                                      TextWrapping="Wrap"/>
                                            <TextBlock x:Name="WelcomeSubtitleText"
                                                      FontSize="14"
                                                      Opacity="0.7"
                                                      TextAlignment="Center"
                                                      TextWrapping="Wrap"
                                                      MaxWidth="360"/>
                                        </StackPanel>
                                        <Button Click="OpenFileButton_Click"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource AccentButtonStyle}"
                                               Padding="24,10">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <SymbolIcon Symbol="OpenFile"/>
                                                <TextBlock x:Name="WelcomeBrowseText" FontSize="14"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                                </SplitView.Content>
                            </SplitView>
                        </Border>

                        <Border x:Name="SettingsHost"
                                FlowDirection="LeftToRight"
                                Visibility="Collapsed"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                CornerRadius="8"
                                Margin="8">
                            <local:SettingsPanel x:Name="AppSettingsPanel"/>
                        </Border>
                </Grid>
            </Grid>
        </NavigationView>

        <Grid x:Name="LoadingOverlay"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Background="#99000000"
              IsHitTestVisible="True"
              Canvas.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="56" Height="56"/>
                <TextBlock x:Name="LoadingOverlayText"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
